{
  "name": "unletter",
  "version": "0.0.0",
  "description": "Alchemy Typescript Project",
  "type": "module",
  "scripts": {
    "build": "tsgo -b",
    "dev": "alchemy dev --stage dev",
    "deploy": "alchemy deploy --stage prod",
    "destroy": "alchemy destroy",
    "postinstall": "vibe-rules install cursor",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "typecheck": "tsgo --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@cloudflare/workers-types": "^4.20260505.1",
    "@types/node": "^25.6.0",
    "@typescript/native-preview": "^7.0.0-dev.20260504.1",
    "@vitest/coverage-v8": "^4.1.5",
    "alchemy": "0.93.7",
    "miniflare": "^4.20260430.0",
    "typescript": "^6.0.3",
    "ultracite": "7.6.3",
    "vibe-rules": "^0.3.91",
    "vitest": "^4.1.5",
    "vitest-environment-miniflare": "^2.14.4",
    "wrangler": "^4.87.0"
  },
  "dependencies": {
    "feed": "^5.2.1",
    "hono": "^4.12.16",
    "nanoid": "^5.1.11",
    "zod": "^4.4.3"
  }
}
