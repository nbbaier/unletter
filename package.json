{
  "name": "unletter",
  "version": "0.0.0",
  "description": "Alchemy Typescript Project",
  "type": "module",
  "scripts": {
    "build": "tsgo -b",
    "dev": "alchemy dev --stage dev",
    "deploy": "alchemy deploy --stage prod",
    "destroy": "alchemy destroy",
    "postinstall": "vibe-rules install cursor",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "typecheck": "tsgo --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@cloudflare/workers-types": "^4.20260317.1",
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "^7.0.0-dev.20260328.1",
    "@vitest/coverage-v8": "^4.1.2",
    "alchemy": "0.90.1",
    "miniflare": "^4.20260317.3",
    "typescript": "^6.0.2",
    "ultracite": "7.3.2",
    "vibe-rules": "^0.3.91",
    "vitest": "^4.1.2",
    "vitest-environment-miniflare": "^2.14.4",
    "wrangler": "^4.78.0"
  },
  "dependencies": {
    "feed": "^5.2.0",
    "hono": "^4.12.9",
    "nanoid": "^5.1.7",
    "zod": "^4.3.6"
  }
}
