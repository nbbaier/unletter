{
  "name": "unletter",
  "version": "0.0.0",
  "description": "Alchemy Typescript Project",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "alchemy dev --stage dev",
    "deploy": "alchemy deploy --stage prod",
    "destroy": "alchemy destroy",
    "postinstall": "vibe-rules install cursor",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.0",
    "@cloudflare/workers-types": "^4.20260214.0",
    "@types/node": "^25.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "alchemy": "0.84.0",
    "miniflare": "^4.20260212.0",
    "typescript": "^5.9.3",
    "ultracite": "7.2.3",
    "vibe-rules": "^0.3.91",
    "vitest": "^4.0.18",
    "vitest-environment-miniflare": "^2.14.4"
  },
  "dependencies": {
    "feed": "^5.2.0",
    "nanoid": "^5.1.6",
    "zod": "^4.3.6"
  }
}
