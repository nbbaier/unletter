{
  "name": "unletter",
  "version": "0.0.0",
  "description": "Alchemy Typescript Project",
  "type": "module",
  "scripts": {
    "build": "tsgo -b",
    "check": "ultracite check",
    "deploy": "alchemy deploy --stage prod",
    "destroy": "alchemy destroy",
    "dev": "alchemy dev --stage dev",
    "fix": "ultracite fix",
    "postinstall": "vibe-rules install cursor",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "feed": "^6.0.0",
    "hono": "^4.13.7",
    "nanoid": "^6.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "alchemy": "0.93.7",
    "miniflare": "^5.20260908.0-alpha",
    "typescript": "^7.0.2",
    "ultracite": "7.11.0",
    "vibe-rules": "^0.3.91",
    "vitest": "^5.0.0",
    "vitest-environment-miniflare": "^2.14.4",
    "wrangler": "^4.130.0"
  }
}
